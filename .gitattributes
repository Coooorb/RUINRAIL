# Line endings: normalize text, keep shell scripts LF for macOS
* text=auto eol=lf
*.cs text diff=csharp
*.sh text eol=lf
*.ps1 text
*.md text
*.txt text
*.json text
*.csv text

# Unity YAML assets (Force Text serialization)
*.asset text
*.unity text
*.prefab text
*.meta text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.physicsMaterial2D text
*.playable text
*.mask text
*.spriteatlas text
*.inputactions text
*.asmdef text
*.shader text
*.shadergraph text

